# ========================================
# PostgreSQL Configuration
# ========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=postgres

# Databases
N8N_DB_NAME=n8n
CHATAPP_DB_NAME=chatapp

# Database URL (usado pelo ChatApp)
DATABASE_URL=postgresql://admin:change-this-strong-password@localhost:5432/chatapp

# ========================================
# Redis Configuration
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# N8N Configuration
# ========================================
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8n-strong-password
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678

# ========================================
# ChatApp Configuration
# ========================================
# URL pública da aplicação
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL interna do N8N (Docker network)
N8N_INTERNAL_URL=http://n8n:5678

# JWT Secret (gere uma chave segura com: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-please-change-this

# Tempo de expiração do token (em segundos)
JWT_EXPIRES_IN=86400

# ========================================
# Auth Providers (opcional - Fase 4)
# ========================================
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# ========================================
# LDAP Configuration (opcional - Fase 4)
# ========================================
LDAP_ENABLED=false
LDAP_URL=ldap://dc.empresa.local
LDAP_PORT=389
LDAP_BASE_DN=DC=empresa,DC=local
LDAP_USER_DN=CN=Users,DC=empresa,DC=local
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})

# ========================================
# Timezone
# ========================================
TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# ========================================
# Email Configuration (opcional - para envio de emails)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourcompany.com
SMTP_FROM_NAME=ChatApp IA

# ========================================
# Application Settings
# ========================================
# Ambiente (development | production)
NODE_ENV=development

# Porta do Next.js
PORT=3000

# Logs
LOG_LEVEL=info

# ========================================
# Legacy API Keys (manter para compatibilidade)
# ========================================
# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-key-here

# Grok API Key
GROK_API_KEY=xai-your-grok-key-here
